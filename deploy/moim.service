[Unit]
Description=Moim application (single worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moim
Group=moim
WorkingDirectory=/opt/moim
EnvironmentFile=/etc/moim/moim.env
Environment=MOIM_DB_PATH=/var/lib/moim/moim.sqlite3
Environment=PYTHONUNBUFFERED=1
# One worker is required: current participant-count coordination is in-process.
ExecStart=/opt/moim/.venv/bin/gunicorn --workers 1 --threads 4 --worker-class gthread --bind 127.0.0.1:8000 --timeout 90 moim.wsgi:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=moim
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/moim

[Install]
WantedBy=multi-user.target
