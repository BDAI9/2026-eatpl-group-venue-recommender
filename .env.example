# Local development only: copy to .env and fill nonempty values as needed.
# Never commit .env or real secret values.
EATPL_SOURCE=kskill
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: fetch Eat.pl menu, price and review data.
EATPL_DETAIL_ENABLED=0
# Kakao JavaScript SDK client key. It is delivered to the browser by /api/options.
# Register the exact frontend domain in Kakao Developers.
KAKAO_JS_KEY=
# Optional server-only REST key for region disambiguation.
KAKAO_REST_API_KEY=
